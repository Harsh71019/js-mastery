          "isPositive?": "false",
          "currentSum": 1
        },
        {
          "num": 2,
          "isPositive?": "true",
          "currentSum": 3
        }
      ]
    },
    "skeletonHint": "function sumPositives(nums) {\n  let sum = 0;\n  nums.forEach(n => {\n    if (n > ____) {\n      sum += ____;\n    }\n  });\n  return sum;\n}",
    "solution": "function sumPositives(nums) {\n  let sum = 0;\n  nums.forEach(n => {\n    if (n > 0) {\n      sum += n;\n    }\n  });\n  return sum;\n}",
